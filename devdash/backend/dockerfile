# AWS Lambda container image for the FastAPI backend.
# Uses the official Lambda Python base image, which bundles the Runtime
# Interface Client so the app runs on Lambda's execution environment.
FROM public.ecr.aws/lambda/python:3.11

# Install dependencies first to leverage Docker layer caching.
# LAMBDA_TASK_ROOT is /var/task — the directory Lambda runs from.
COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code.
COPY ./app ${LAMBDA_TASK_ROOT}/app

# Handler: module.attribute pointing at the Mangum adapter in app/lambda_handler.py
CMD ["app.lambda_handler.handler"]
